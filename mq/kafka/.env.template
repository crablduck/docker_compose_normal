# Kafka Configuration Template
# 复制此文件为 .env 并根据环境修改配置

# 容器内部通信使用的主机名（通常不需要修改）
KAFKA_HOST=kafka

# 外部访问的主机地址（根据部署环境修改）
# 开发环境示例：KAFKA_EXTERNAL_HOST=localhost
# 测试环境示例：KAFKA_EXTERNAL_HOST=192.168.1.100
# 生产环境示例：KAFKA_EXTERNAL_HOST=kafka.company.com
KAFKA_EXTERNAL_HOST=172.16.1.172

# Kafka 外部访问端口
KAFKA_EXTERNAL_PORT=9092

# Kafka UI 访问端口
KAFKA_UI_PORT=10180

# 使用说明：
# 1. 容器间通信：使用 kafka:9092
# 2. 外部应用连接：使用 ${KAFKA_EXTERNAL_HOST}:${KAFKA_EXTERNAL_PORT}
# 3. Kafka UI 访问：http://${KAFKA_EXTERNAL_HOST}:${KAFKA_UI_PORT}