# Kafka Configuration Example
# Copy this file to .env and modify as needed

# Kafka hostname/IP - change this to your server IP or domain
KAFKA_HOST=kafka
# For localhost access: KAFKA_HOST=localhost
# For specific IP: KAFKA_HOST=192.168.1.100
# For domain: KAFKA_HOST=kafka.yourdomain.com

# Kafka external port
KAFKA_EXTERNAL_PORT=9092

# Kafka UI port
KAFKA_UI_PORT=10180